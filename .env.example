# Sao chép file này thành .env rồi điền giá trị thật (KHÔNG commit .env)
# Cơ sở dữ liệu PostgreSQL 16 – mật khẩu 123456 khớp lệnh docker run ở README mục 3 (chỉ dùng trên máy phát triển)
# Dùng PostgreSQL cài sẵn thì đổi 123456 thành mật khẩu user postgres của bạn
DATABASE_URL=postgres://postgres:123456@localhost:5432/smartcrm
# Cổng chạy API
PORT=3000
# Khóa ký JWT (chuỗi ngẫu nhiên dài)
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat
# Địa chỉ giao diện được phép gọi API (CORS) – khớp cổng của src/frontend (mặc định 5173)
FRONTEND_ORIGIN=http://localhost:5173
