# Sao chép file này thành .env (KHÔNG commit .env). Mọi giá trị dưới đây chỉ là GIÁ TRỊ MẪU (TD-21):
# hãy đổi thành giá trị của riêng bạn – không ghi mật khẩu thật vào README, docs hay commit.
# Mật khẩu PostgreSQL – đọc bởi lệnh `docker run --env-file .env` (README bước 4) và docker compose (dịch vụ db)
POSTGRES_PASSWORD=doi_mat_khau_nay
# Chuỗi kết nối cho backend – mật khẩu phải TRÙNG với POSTGRES_PASSWORD ở trên
DATABASE_URL=postgres://postgres:doi_mat_khau_nay@localhost:5432/smartcrm
# Cổng chạy API
PORT=3000
# Khóa ký JWT (chuỗi ngẫu nhiên dài)
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat
# Địa chỉ giao diện được phép gọi API (CORS) – localhost và 127.0.0.1 là hai origin KHÁC nhau với trình duyệt, cách nhau bằng dấu phẩy
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Mức log: debug | info | warn | error (mặc định info)
LOG_LEVEL=info
