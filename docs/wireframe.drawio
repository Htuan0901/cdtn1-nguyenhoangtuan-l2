lor=#C9B200;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="780" y="20" width="200" height="72" as="geometry"/></mxCell><mxCell id="p1-51" value="&lt;b&gt;Nguồn dữ liệu&lt;/b&gt;&lt;br&gt;① customer.phone, customer.full_name&lt;br&gt;② device.serial_imei, device.model_name, device.purchase_date, device.warranty_months&lt;br&gt;③ ticket.issue_desc, issue_category.name, ticket.priority&lt;br&gt;④ ticket.warranty_result, ticket.status, ticket.due_at&lt;br&gt;Trung tâm: staff.center_code (thanh trên cùng)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#FFF9C4;strokeColor=#C9B200;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="200" height="210" as="geometry"/></mxCell><mxCell id="p1-52" value="&lt;b&gt;Ngoại lệ ↔ chỗ hiển thị&lt;/b&gt;&lt;br&gt;Chữ đỏ đặt ngay dưới trường liên quan; số trong ngoặc là bước ngoại lệ của UC04 (mục 2.2)." style="whiteSpace=wrap;html=1;rounded=0;fillColor=#FFF9C4;strokeColor=#C9B200;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="780" y="318" width="200" height="100" as="geometry"/></mxCell><mxCell id="p1-53" value="&lt;b&gt;Quy tắc&lt;/b&gt;&lt;br&gt;SĐT chuẩn hoá trước khi tra cứu (QT-02). Hạn cam kết tính theo QT-04, chỉ ngày làm việc T2–T7." style="whiteSpace=wrap;html=1;rounded=0;fillColor=#FFF9C4;strokeColor=#C9B200;strokeWidth=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="780" y="426" width="200" height="100" as="geometry"/></mxCell><mxCell id="p1-54" value="Nhãn trường dùng đ