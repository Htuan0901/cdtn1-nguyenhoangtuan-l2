{
  "name": "smartcrm-l2-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Smart CRM – Luồng L2: Tiếp nhận và phân loại yêu cầu bảo hành (backend 4 lớp)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node -r ./scripts/load-env.js src/server.js",
    "dev": "node -r ./scripts/load-env.js --watch src/server.js",
    "migrate": "node -r ./scripts/load-env.js scripts/migrate.js",
    "seed": "node -r ./scripts/load-env.js scripts/seed-mau.js",
    "token": "node -r ./scripts/load-env.js scripts/make-token.js",
    "demo": "node -r ./scripts/load-env.js scripts/demo.js",
    "nfr2": "node -r ./scripts/load-env.js scripts/nfr2-concurrency.js",
    "test": "node --test ../../tests/backend/slaPolicy.test.js ../../tests/backend/warrantyPolicy.test.js ../../tests/backend/phonePolicy.test.js ../../tests/backend/ticketService.test.js ../../tests/backend/validator.test.js ../../tests/backend/buoi10.test.js ../../tests/backend/buoi11.test.js ../../tests/backend/buoi12.test.js ../../tests/backend/buoi14.test.js ../../tests/backend/buoi16.test.js",
    "e2e": "node -r ./scripts/load-env.js scripts/e2e.js",
    "crud": "node -r ./scripts/load-env.js scripts/crud.js",
    "st": "node -r ./scripts/load-env.js scripts/system-test.js",
    "test:repo": "node -r ./scripts/load-env.js ../../tests/repository/repositories.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
